# Use a DEDICATED gmail account for this, not your personal one.
#
# 1. Create/pick a gmail account, e.g. thetable.hackathon@gmail.com
# 2. Turn on 2-Step Verification (required for App Passwords):
#    https://myaccount.google.com/security
# 3. Create an App Password:
#    https://myaccount.google.com/apppasswords
#    (choose "Mail" as the app, any device name)
#    Copy the 16-character password it gives you — that's GMAIL_APP_PASSWORD
# 4. IMAP must be enabled: Gmail settings -> "See all settings" ->
#    "Forwarding and POP/IMAP" tab -> Enable IMAP -> Save

GMAIL_ADDRESS=pigeonmailroom@gmail.com
GMAIL_APP_PASSWORD=
# apparently GMAIL_APP_PASSWORD is a security risk in this public repo
# email jakedeguzman2442@gmail.com if you want it

PORT=3000
